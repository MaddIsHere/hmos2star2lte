diff --git a/arch/arm64/configs/vendor/ohos.config b/arch/arm64/configs/vendor/ohos.config
new file mode 100644
index 000000000..e7e023738
--- /dev/null
+++ b/arch/arm64/configs/vendor/ohos.config
@@ -0,0 +1,25 @@
+# HarmonyOS / OpenHarmony userspace on star2lte (Exynos 9810, 4.9.337) - merge over star2lte_defconfig
+CONFIG_ACCESS_TOKENID=y
+CONFIG_BINDER_SENDER_INFO=y
+CONFIG_OHOS_FS_EMU=y
+CONFIG_OHOS_FSVERITY_STUB=y
+CONFIG_OHOS_BRINGUP_NOREBOOT=y
+CONFIG_OHOS_BRINGUP_PERMISSIVE=y
+CONFIG_SECURITY_SELINUX_DEVELOP=y
+# OHOS does not use Android's AID_INET socket gating
+# CONFIG_ANDROID_PARANOID_NETWORK is not set
+# OHOS init creates /dev/binder from uevents; binderfs would hide the misc devices
+# CONFIG_ANDROID_BINDERFS is not set
+CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
+# persistent logs for bring-up (read from TWRP: /sys/fs/pstore)
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
+CONFIG_PSTORE_RAM=y
+CONFIG_DEVTMPFS=y
+CONFIG_TMPFS=y
+CONFIG_TMPFS_XATTR=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_MEMCG=y
+CONFIG_ZRAM=y
+CONFIG_PSI=y
